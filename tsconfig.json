{
  // Path aliases (#shared, #domains, @mapping, @schema) are generated into
  // ./.nuxt/tsconfig.json from `nuxt.config.ts` — do not redefine `paths` here,
  // it would override Nuxt's mappings (#app, #imports, ...).
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals"]
  }
}
